# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.

# Base de datos Upstash Redis. La integración de Vercel las crea sola, con estos
# nombres o con KV_REST_API_URL y KV_REST_API_TOKEN (el código acepta ambos).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Texto aleatorio que se mezcla al anonimizar a cada visitante. Obligatorio.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VISITS_SALT=

# Opcional: dominios que pueden sumar visitas, separados por comas.
# Si no se define, solo portfolio-juan-fonseca.vercel.app. Cámbialo si usas dominio propio.
VISITS_ALLOWED_HOSTS=portfolio-juan-fonseca.vercel.app